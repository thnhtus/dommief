{
  "name": "dommief-root",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build && pnpm -C examples/docs build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p packages/theme-default --noEmit && tsc -p examples/docs --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "eslint": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
